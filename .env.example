# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# GOOGLE_MAPS_API_KEY: Required for interactive GIS Google Map overlay.
VITE_GOOGLE_MAPS_API_KEY=

# PROTOTYPE NOTIFICATION CONFIGURATION
PROTOTYPE_NOTIFICATION_MODE=true
PROTOTYPE_NOTIFICATION_OFFER=1
PROTOTYPE_WHATSAPP_NUMBER=
PROTOTYPE_EMAIL=

# EMAIL NOTIFICATION SERVICE CONFIGURATION
EMAIL_API_KEY=
EMAIL_FROM=notifications@landguard.gov.in

# WHATSAPP BUSINESS / CLOUD API CONFIGURATION
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_TEMPLATE_NAME=landguard_risk_alert
WHATSAPP_VERIFY_TOKEN=landguard_whatsapp_webhook_token_2026
